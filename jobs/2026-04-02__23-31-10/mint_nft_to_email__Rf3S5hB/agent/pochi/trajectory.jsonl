{"type":"message-part","messageId":"0fd5dbf3-0fbb-498d-942a-efb985e8c122","role":"assistant","index":3,"part":{"type":"tool-writeToFile","toolCallId":"GwRGuzGmCbuT0oUz","state":"input-streaming","input":{"content":"const fs = require('fs');\nconst fetch = require('node-fetch');\n\nasync function mintNFT() {\n    const url = 'https://staging.crossmint.com/api/2022-06-09/collections/default/nfts';\n    \n    const payload = {\n        recipient: 'email:test@example.com:polygon-amoy',\n        metadata: {\n            name: 'Welcome NFT',\n            description: 'A welcome gift',\n            image: 'https://example.com/nft.png'\n        }\n    };\n\n    try {\n        const response = await fetch(url, {\n            method: 'POST',\n            headers: {\n                'x-api-key': process.env.CROSSMINT_API_KEY || '',\n                'Content-Type': 'application/json'\n            },\n            body: JSON.stringify(payload)\n        });\n\n        let data;\n        try {\n            data = await response.json();\n        } catch (e) {\n            data = response.statusText;\n        }\n\n        if (!response.ok) {\n            fs.writeFileSync('/home/user/mint_response.json', JSON.stringify({ error: data }, null, 2));\n        } else {\n            fs.writeFileSync('/home/user/mint_response.json', JSON.stringify(data, null, 2));\n        }\n    } catch (error) {\n        fs.writeFileSync('/home/user/mint_response.json', JSON.stringify({ error: error.message }, null, 2));\n    }\n}\n\nmintNFT();\n","path":"/home/user/mint_nft.js"}}}
